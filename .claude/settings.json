{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm db:test)",
      "Bash(pnpm db:types)",
      "Bash(supabase start)",
      "Bash(supabase status)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(eas submit:*)",
      "Bash(eas update:*)"
    ]
  }
}
