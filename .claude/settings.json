{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm tokens)",
      "Bash(pnpm tokens:check)",
      "Bash(pnpm db:test)",
      "Bash(pnpm db:types)",
      "Bash(supabase start)",
      "Bash(supabase status)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format)",
      "Bash(uv run ruff format *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(!.env.example)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(eas submit:*)",
      "Bash(eas update:*)"
    ]
  }
}
