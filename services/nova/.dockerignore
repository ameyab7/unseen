# Keys never go into the image: compose.yaml passes services/nova/.env in when it runs.
# At any depth, as in .gitignore: a .env left in a subfolder must not be copied either.
**/.env
**/.env.*
!**/.env.example
.venv
rehearsals
voice-samples
**/__pycache__
**/.pytest_cache
**/.ruff_cache
# The independent held-out set (decision 0005) stays on the machine that wrote it: never in
# an image. The evaluation that reads it runs natively; it imports no LiveKit.
independent/*.json
