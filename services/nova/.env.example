# Copy this file to .env in the same folder and fill in the values.
# .env is never committed; this file lists the names only.

# LiveKit Cloud project (Settings > API keys). The secret stays on this PC.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which language model writes Nova's lines, as provider/model. For example:
#   ollama/gemma4:26b             local Gemma through Ollama (development)
#   anthropic/claude-haiku-5-5    Claude Haiku 5.5
#   anthropic/claude-opus-5-5     Claude Opus 5.5
NOVA_LLM=

# Optional. The model for the distress check's labels, as provider/model (default: NOVA_LLM).
# It receives every utterance daters say on air: an anthropic/ model sends them to Anthropic.
NOVA_CLASSIFIER_LLM=

# Needed only when NOVA_LLM or NOVA_CLASSIFIER_LLM starts with anthropic/.
ANTHROPIC_API_KEY=

# Optional. Where Ollama runs. Leave empty for this PC (http://localhost:11434). In Docker,
# compose.yaml always uses host.docker.internal instead.
OLLAMA_BASE_URL=

# Floor tracking (default true), full-length rehearsal (default true), and discretionary
# conversation overrun (default 60 seconds; excludes safety holds).
NOVA_CONVERSATIONAL_TURNS=
NOVA_FULL_REHEARSAL=
NOVA_CONVERSATION_OVERRUN_SECONDS=

# Optional live prefixes to prepared questions (default false until audio/load trials).
# Every prefix passes a meaning check; failure uses the existing prepared question.
NOVA_LIVE_BRIDGES=

# For a two-person rehearsal, set both distinct LiveKit participant identities.
# Each input is pinned to its own track. Empty: one microphone simulates both seats.
NOVA_LEFT_PARTICIPANT=
NOVA_RIGHT_PARTICIPANT=

# Optional. Seconds a live reaction may take before Nova uses a fallback line (default 2).
NOVA_LIVE_TIMEOUT_SECONDS=

# Optional. Seconds one request for a set piece may take before the date (default 60; a
# cold model load took 20-28 s).
NOVA_PREP_TIMEOUT_SECONDS=

# Optional. Seconds preparing all of a date's set pieces may take before the rest use
# their fallback (default 45).
NOVA_PREP_BUDGET_SECONDS=

# Optional. Set pieces requested at once while they're prepared (default 1). Match Ollama's
# OLLAMA_NUM_PARALLEL: more never prepares faster, and a distress check waits behind them.
NOVA_PREP_PARALLEL=

# Optional. Seconds the distress check may take before the moderator is alerted to listen
# in instead (default 2).
NOVA_DISTRESS_TIMEOUT_SECONDS=

# Optional. How long Nova waits, once a dater has stopped speaking and the last transcript
# is in, before acting on what they said (default 0.6). Counts against the 2.5 s reply target.
NOVA_UTTERANCE_GRACE_SECONDS=

# Optional. The most Nova waits after a dater stops speaking, however late transcripts come
# (default 1.5).
NOVA_UTTERANCE_MAX_WAIT_SECONDS=

# Optional. Nova's voice, one of LiveKit's built-in voices, as provider/model:voice
# (default: Cartesia Sonic 3, Robyn). For example deepgram/aura-2:odysseus
NOVA_VOICE=

# Optional. Speech recognition that hears the daters, as provider/model (default
# deepgram/nova-3).
NOVA_STT=

# One deadline for warming the model up before a date, in seconds (default 90).
NOVA_WARM_UP_SECONDS=

# Off until the privacy notice covers it (decision 0005): true lets this date's recent turns
# go into the prompts of a model that is not local (NOVA_LLM=anthropic/...). Local Ollama
# always sees them. Synthetic runs (the evaluation, the benchmark) are not affected.
NOVA_DIALOGUE_TO_PROVIDER=

# The meaning check on Nova's lines (decision 0005): set pieces before the date (default
# true), live lines (default false, until a labelled set measures it), and the seconds one
# set piece's check may take (default 5).
NOVA_MEANING_CHECK=
NOVA_MEANING_LIVE=
NOVA_MEANING_TIMEOUT_SECONDS=

# Hosts besides loopback (localhost, 127.0.0.1, ::1) that count as local for a model's
# endpoint, separated by commas (decision 0010): only a host you run, where nobody else
# receives what it's sent. A model elsewhere sees this date's turns only with
# NOVA_DIALOGUE_TO_PROVIDER. Docker's host.docker.internal isn't local unless named here.
NOVA_APPROVED_LOCAL_HOSTS=

# true lets ANTHROPIC_LOG or OPENAI_LOG be "debug", which logs every prompt sent: for the
# evaluation or the benchmark only, on made-up daters. The agent refuses to start with it.
NOVA_SYNTHETIC_DIAGNOSTICS=

# How long the doors may hold while Nova tries again to get ready after the warm-up and the
# prep budget ran out (decision 0011): seconds, default 120. Then the moderator decides.
NOVA_READY_RETRY_SECONDS=
