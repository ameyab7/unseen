# Copy this file to .env in the same folder and fill in the values.
# Anything starting EXPO_PUBLIC_ is built into the app and readable by anyone who has
# it, so never put a secret here. LiveKit keys belong in services/nova/.env.

# LiveKit project URL (wss://...). Public, not a secret.
EXPO_PUBLIC_LIVEKIT_URL=

# Development only: the listen-only token endpoint running on this PC. On the
# emulator, run `adb reverse tcp:<port> tcp:<port>` and use http://localhost:<port>.
EXPO_PUBLIC_DEV_TOKEN_URL=
